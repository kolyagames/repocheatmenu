		<SkipType name="RepoCheatMenu.GhostVoicePatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.GhostRecorderPatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.GhostSessionLatchPatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.GhostNetFilterPatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.GhostVoiceViewPatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.GhostTransmitForcePatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.GhostRiderPatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.TPosePatch" skipMethods="true" />
