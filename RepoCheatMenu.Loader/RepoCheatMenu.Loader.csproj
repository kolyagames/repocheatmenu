<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>RepoCheatMenu.Loader</AssemblyName>
    <RootNamespace>RepoCheatMenu.Loader</RootNamespace>
    <Company>Kolya</Company>
    <Authors>Kolya</Authors>
    <Product>RepoCheatMenu</Product>
    <Copyright>© Kolya</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- Deliberately tiny and free of game references: this DLL is the one part that can never be
       hot-swapped, so it must almost never need to change. It only knows BepInEx and Unity. -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

</Project>
