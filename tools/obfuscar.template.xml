		<SkipType name="RepoCheatMenu.FakePingPatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.FakeOverchargePatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.DiscoBeamPatch" skipMethods="true" />
