		<SkipType name="RepoCheatMenu.AntiCrashExecuteRpcPatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.AntiCrashOnEventPatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.DeferredAntiCrashInstallPatch" skipMethods="true" />
		<SkipType name="RepoCheatMenu.AntiCrashTextSanitize" skipMethods="true" />
		<SkipType name="RepoCheatMenu.IgnoreDeathPatch" skipMethods="true" />
